  "narrative": {
    "northStar": "The Narrowing Search",
    "overview": "skyback is used in loops: a half-remembered word goes in, a pile of posts comes back, and the next move is to refine. A blue band carries the wordmark and status, and the search card overlaps its lower edge as the stable top of the page; results with marked matches sit directly below. The surface is flat and bordered, with system type and a single Bluesky blue for things you can act on.",
    "keyCharacteristics": [
      "Search first: the query sits in a card that overlaps the blue band.",
      "The wordmark rides on a white tab: dark \"sky\", Signal Blue \"back\".",
      "Flat everywhere: borders, never shadows.",
      "One accent, used only on things you can act on or that have focus.",
      "Matched words are always visibly marked in results.",
      "Pill-shaped small controls, softly rounded larger containers.",
      "Light and dark follow the system.",
      "Phone width is the primary constraint."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Signal blue marks what you can act on or what has focus, plus the \"back\" of the wordmark. The only other blue is the band and the 12% wash.",
        "section": "colors"
      },
      {
        "name": "The Matches Are Yellow Rule",
        "body": "The highlighter is the only warm, saturated mark in the interface.",
        "section": "colors"
      },
      {
        "name": "The Post Is The Biggest Thing Rule",
        "body": "Post text is body size and full-strength ink; everything about a post is smaller and muted.",
        "section": "typography"
      },
      {
        "name": "The Search Stays Put Rule",
        "body": "The search card and its filters are the stable top of the page. Refining a query must never move them, collapse them, or clear what was typed.",
        "section": "layout"
      },
      {
        "name": "The Hairlines Not Shadows Rule",
        "body": "Separate surfaces with a 1px hairline and a tonal step. Never add a shadow or a blur.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the search card directly under the band, unchanged, as the query is refined.",
      "Do mark every matched word in results with the highlighter.",
      "Do use hairlines and tonal steps to separate surfaces.",
      "Do define every color as a custom property with a dark counterpart, and keep the two modes structurally identical.",
      "Do keep controls at least 26px tall, and prefer 32px for anything the owner taps on a phone.",
      "Do build post content with textContent; highlights arrive as markers and become mark nodes.",
      "Do keep owner controls and demo content strictly separated in markup (the owner and demo blocks)."
    ],
    "donts": [
      "Don't add shadows, blurs, gradients or glass effects.",
      "Don't use signal blue for decoration beyond the wordmark, or yellow for anything but a match.",
      "Don't load web fonts or icon fonts.",
      "Don't put owner-only controls (Sync, Feeds, Search further back, status) in the demo markup.",
      "Don't make the interface louder than the posts it contains.",
      "Don't reflow or clear the search input when results update."
    ]
  }
